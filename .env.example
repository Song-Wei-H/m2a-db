POSTGRES_PASSWORD=replace_me
DATABASE_URL=postgresql+asyncpg://m2a_user:replace_me@localhost:15432/m2a_pentest

KALI_WORKER_BASE_URL=http://192.0.2.10:8000
KALI_WORKER_URL=http://192.0.2.10:8000

DISPATCHER_POLL_INTERVAL_SECONDS=10
KALI_WORKER_TIMEOUT_SECONDS=600
DISPATCHER_STALE_RUNNING_MINUTES=30

API_PORT=8000

WORKER_POLL_INTERVAL_SECONDS=10
WORKER_TOOL_TIMEOUT_SECONDS=300

DIRB_WORDLIST=/usr/share/dirb/wordlists/common.txt

# Target scope is enforced by the deployment network controls (NDR and microsegmentation),
# not by Kali Worker. M2A approval and tool policies still apply.
ENFORCE_TARGET_SCOPE=false
# Optional local allowlists. These are used only when ENFORCE_TARGET_SCOPE=true.
# ALLOWED_SCOPES=192.0.2.0/24,203.0.113.0/24
# ALLOWED_HOSTNAMES=app.example.test
# ALLOWED_DOMAIN_SUFFIXES=internal.example
ALLOWED_LLM_PROFILES=internal

ALLOWED_TOOLS=nmap_service,httpx_basic,nuclei_safe,dirb_safe,ssh-enum,mysql-info,tls_certificate,http_security_headers,dns_metadata

# Advisory decision model: only the minimal context built in
# worker/llm_decision.py is sent to this OpenAI-compatible LiteLLM service.
# The response remains subject to the JSON validator, tool allowlist and human
# approval gate before any ToolTask can be created.
# Replace these examples with the OpenAI-compatible service and model used by
# your authorized deployment. 192.0.2.0/24 is reserved for documentation.
LLM_BASE_URL=http://192.0.2.20:8000/v1
LLM_MODEL=openai/replace-with-model-name
LLM_API_KEY=
LLM_SEND_AUTH=false
LLM_TIMEOUT_SECONDS=60
LLM_CONTEXT_MAX_HISTORY=3
MAX_CVE_VALIDATIONS_PER_ROUND=3
CVE_LOCAL_INDEX_PATH=data/cve_index.sqlite3
CVE_LOCAL_INDEX_ENABLED=false
CVE_QUERY_SAFETY_LIMIT=5000
CVE_REPORT_CANDIDATE_BUDGET=50
# Set LLM_SEND_AUTH=true and provide LLM_API_KEY only if this service requires it.

# Windows Launcher（操作介面使用繁體中文；identifier 與 protocol 保持不變）
M2A_WORKER_MODE=wsl
M2A_WSL_DISTRO=kali-linux
M2A_WSL_WORKER_DIR=/opt/m2a
M2A_WSL_WORKER_PORT=18000
# M2A_REMOTE_WORKER_URL=http://192.0.2.10:8000
M2A_BACKEND_HOST=127.0.0.1
M2A_BACKEND_PORT=8000
M2A_FRONTEND_PORT=5173
M2A_STARTUP_TIMEOUT=60
M2A_WORKER_TIMEOUT=30
M2A_AUTO_OPEN_BROWSER=true
M2A_LAUNCHER_DEBUG=false
