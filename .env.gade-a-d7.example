# Documentation-only values. Replace each address/subnet with the home lab's
# isolated values before running Initialize-GadeHomeLab.ps1. These TEST-NET
# examples are not routable and the initializer rejects them.
GADE_A_D7_HOST_BIND_IP=192.0.2.10
GADE_A_D7_HOST_PORT=18081
GADE_A_D7_INGRESS_SUBNET=172.30.240.0/24
GADE_A_D7_INGRESS_GATEWAY=172.30.240.1
GADE_A_D7_IMAGE=gade-a-d7-home:local
GADE_A_D7_COMPOSE_PROJECT=gade-a-d7-home
GADE_A_D7_TARGET_ENV_FILE=lab/mode-b-target/.env.target.local
GADE_A_D7_BLUE_ENV_FILE=lab/mode-b-target/.env.blue.local
GADE_A_D7_COMPONENT_ENV_FILE=lab/mode-b-target/.env.component.local
GADE_OFFICE_DOCKER_LAB_TARGET=192.0.2.10
GADE_OFFICE_DOCKER_LAB_PORT=18081
GADE_LAB_TARGET_HOST=192.0.2.10
GADE_LAB_TARGET_PORT=18081
GADE_LAB_TARGET_SCOPE=192.0.2.10/32
GADE_SCENARIO_B_TARGET_HOST=192.0.2.10
GADE_SCENARIO_B_TARGET_TRUTH_SHA256=SET_BY_INITIALIZER
GADE_KALI_WORKER_HOST=192.0.2.20
GADE_L3_EXPECTED_WORKER_URL=http://192.0.2.20:8001
# Set these locally if Worker deployment/management is needed; never place a
# password, key, token, or credential in this file.
GADE_KALI_SSH_TARGET=user@192.0.2.20
GADE_KALI_WORKER_REMOTE_DIR=/home/user/gade-worker
# Set GADE_OBSIDIAN_VAULT in PowerShell to this machine's local Canonical Vault
# root if Runner finalization is configured to append the approved M2A notes.
